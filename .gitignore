# Dependencies
node_modules/

# Secrets — never commit real env values
.env
.env.local

# Logs
storage/logs/*.log

# Uploaded content — keep the folder structure, not the contents
public/uploads/avatars/*
public/uploads/blog/*
public/uploads/companies/*
public/uploads/properties/*
!public/uploads/avatars/.gitkeep
!public/uploads/blog/.gitkeep
!public/uploads/companies/.gitkeep
!public/uploads/properties/.gitkeep

storage/uploads/documents/*
!storage/uploads/documents/.gitkeep

# OS/editor cruft
.DS_Store
*.swp
.vscode/
.idea/

# npm
npm-debug.log*
